# Apache 2.4: merge with existing hosting/API rules before publishing.
Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html
RewriteEngine On

# Preserve the preferred domain; HTTPS enforcement belongs to the host/proxy.
RewriteCond %{HTTP_HOST} ^www\.ndrkfgc\.edu\.in$ [NC]
RewriteRule ^ https://ndrkfgc.edu.in%{REQUEST_URI} [R=301,L,NE]

# Normalize only browser requests, not internal index rewrites.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(about-us|academics|courses|admissions|alumni|life|career-academy|faqs|mandatory-disclosure)/(index\.html)?[\s?] [NC]
RewriteRule ^(about-us|academics|courses|admissions|alumni|life|career-academy|faqs|mandatory-disclosure)/ /$1 [R=301,L]

# Real HTML for known pages. Never turn every unknown URL into a 200 homepage.
RewriteRule ^(about-us|academics|courses|admissions|alumni|life|career-academy|faqs|mandatory-disclosure)$ $1/index.html [END]

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
